# Application
APP_ENV=local
LOG_LEVEL=INFO
SENTRY_DSN=

# Public URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEFAULT_BUSINESS_ID=
NEXT_PUBLIC_DEFAULT_DOMAIN_ID=

# Server-side Supabase and database credentials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+psycopg://companybrain:companybrain@localhost:5432/companybrain
DATABASE_MIGRATION_URL=postgresql+psycopg://companybrain:companybrain@localhost:5432/companybrain

# Auth
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
AUTH_AUDIENCE=authenticated

# Redis / worker
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024

# Gemini temporary chat test provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google Document AI
GCP_PROJECT_ID=
GCP_LOCATION=
DOCAI_PROCESSOR_ID=
DOCAI_PROCESSOR_VERSION=
GOOGLE_APPLICATION_CREDENTIALS=

# Storage and uploads
SUPABASE_STORAGE_BUCKET=business-documents
MAX_UPLOAD_MB=25
SIGNED_URL_EXPIRY_SECONDS=900
MAX_IMAGE_PIXELS=50000000
MAX_PDF_PAGES=500
MAX_ARCHIVE_ENTRIES=10000
INGESTION_JOB_MAX_ATTEMPTS=3
INGESTION_PROCESSING_TIMEOUT_SECONDS=300

# Market/OCR defaults retained for future domain work
DEFAULT_MARKET=dubai_fnv
OCR_CONFIDENCE_THRESHOLD=0.85
