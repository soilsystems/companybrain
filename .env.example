# Company Brain — credential & config VARIABLE NAMES only.
# NEVER put real values here. Real secrets live in each platform's own vault:
#   - OpenAI / Document AI / Drive keys  → n8n Credentials vault (+ Xano env for anything Xano calls)
#   - Xano service token & webhook secret → Xano env + n8n Credentials
#   - Bubble holds NO third-party secrets.
# This file documents WHAT exists and WHERE it lives, so a new engineer can find every secret.

# ── Xano ────────────────────────────────────────────────
XANO_INSTANCE_BASE_URL=            # https://x8xx-xxxx-xxxx.xano.io   (instance root; API groups add /api:xxxx)
XANO_SERVICE_TOKEN=                # machine token, role=service (used by n8n → Xano)
XANO_METADATA_TOKEN=              # Metadata API token (schema export/backup; scripts/export-xano-schema.sh)
XANO_WEBHOOK_HMAC_SECRET=          # shared secret; signs Xano → n8n webhooks (X-CB-Signature)

# ── n8n ─────────────────────────────────────────────────
N8N_BASE_URL=                      # n8n instance URL
N8N_INGESTION_WEBHOOK_URL=         # Xano posts here to start WF1
N8N_WEBHOOK_HMAC_SECRET=           # must match XANO_WEBHOOK_HMAC_SECRET

# ── Google Cloud / Document AI ──────────────────────────
GCP_PROJECT_ID=
BILLING_ACCOUNT_ID=                # for scripts/provision-gcp.sh budget alert (gcloud billing accounts list)
GCP_LOCATION=                      # e.g. eu  or  us  (Document AI processor region)
DOCAI_PROCESSOR_ID=                # the custom extractor processor id
DOCAI_PROCESSOR_VERSION=           # pinned version for reproducibility
GCP_SERVICE_ACCOUNT_JSON=          # path/reference to the SA key (stored in n8n vault, NOT here)

# ── Google Drive ────────────────────────────────────────
DRIVE_ROOT_FOLDER_ID=              # /CompanyBrain root folder id
DRIVE_SERVICE_ACCOUNT_JSON=        # SA with access to the archive folder (n8n vault)

# ── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=                    # n8n vault + Xano env (for in-Xano chat orchestration)
OPENAI_MODEL_CHAT=                 # e.g. gpt-4.1-mini (config, swappable)
OPENAI_MODEL_NORMALIZATION=        # model for WF3 unresolved-row matching
OPENAI_MODEL_INSIGHT=              # model for WF8 daily narrative
OPENAI_MONTHLY_BUDGET_ALERT_USD=   # budget alert threshold

# ── App config (non-secret; may also live in organizations.settings) ──
DEFAULT_MARKET=dubai_fnv
ANOMALY_THRESHOLD_PCT=40           # price spike flag threshold
MISSING_PRODUCT_WINDOW_DAYS=7      # window for "missing products" detection
CHAT_HISTORY_RETENTION_MONTHS=12
OCR_CONFIDENCE_THRESHOLD=0.85      # rows below this are flagged low_confidence
